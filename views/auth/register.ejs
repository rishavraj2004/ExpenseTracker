<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Create Account — ExpenseTrack</title>
  <link rel="stylesheet" href="/css/register.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=DM+Sans:wght@300;400;500&display=swap"
    rel="stylesheet">
</head>

<body>

  <div class="page-wrapper">

    <!-- Left decorative panel -->
    <div class="visual-panel">
      <div class="panel-content">
        <div class="logo-mark">₹</div>
        <h1 class="brand-name">Expense<br /><span>Track</span></h1>
        <p class="brand-tagline">Everything you need to manage your money with confidence.</p>
        <ul class="perks-list">
          <li>
            <span class="perk-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2">
                <rect x="2" y="7" width="20" height="14" rx="2" />
                <path d="M16 7V5a2 2 0 0 0-4 0v2" />
                <line x1="12" y1="12" x2="12" y2="16" />
              </svg>
            </span>
            Track every expense in real time
          </li>
          <li>
            <span class="perk-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2">
                <line x1="18" y1="20" x2="18" y2="10" />
                <line x1="12" y1="20" x2="12" y2="4" />
                <line x1="6" y1="20" x2="6" y2="14" />
              </svg>
            </span>
            Visual reports &amp; spending insights
          </li>
          <li>
            <span class="perk-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
              </svg>
            </span>
            Secure, private &amp; free to use
          </li>
          <li>
            <span class="perk-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10" />
                <polyline points="12 6 12 12 16 14" />
              </svg>
            </span>
            Monthly budget goals &amp; alerts
          </li>
        </ul>
      </div>
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="orb orb-3"></div>
    </div>

    <!-- Right: Register form -->
    <div class="form-panel">
      <div class="form-card">

        <div class="form-header">
          <h2>Create account</h2>
          <p>Start tracking your expenses for free</p>
        </div>

        <% if (locals.error) { %>
          <div class="alert alert-error">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10" />
              <line x1="12" y1="8" x2="12" y2="12" />
              <line x1="12" y1="16" x2="12.01" y2="16" />
            </svg>
            <%= error %>
          </div>
          <% } %>

            <form action="/auth/signup" method="POST" class="register-form" novalidate>

              <div class="name-row">
                <div class="field-group">
                  <label for="firstName">First name</label>
                  <div class="input-wrap">
                    <svg class="input-icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15"
                      viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                      <circle cx="12" cy="7" r="4" />
                    </svg>
                    <input type="text" id="firstName" name="firstName" placeholder="Ravi"
                      value="<%= locals.firstName || '' %>" autocomplete="given-name" required />
                  </div>
                </div>
                <div class="field-group">
                  <label for="lastName">Last name</label>
                  <div class="input-wrap">
                    <svg class="input-icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15"
                      viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                      <circle cx="12" cy="7" r="4" />
                    </svg>
                    <input type="text" id="lastName" name="lastName" placeholder="Kumar"
                      value="<%= locals.lastName || '' %>" autocomplete="family-name" required />
                  </div>
                </div>
              </div>

              <div class="field-group">
                <label for="email">Email address</label>
                <div class="input-wrap">
                  <svg class="input-icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                    fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                    <polyline points="22,6 12,13 2,6" />
                  </svg>
                  <input type="email" id="email" name="email" placeholder="you@example.com"
                    value="<%= locals.email || '' %>" autocomplete="email" required />
                </div>
              </div>

              <div class="field-group">
                <label for="password">Password</label>
                <div class="input-wrap">
                  <svg class="input-icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                    fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="11" width="18" height="11" rx="2" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                  </svg>
                  <input type="password" id="password" name="password" placeholder="Min. 8 characters"
                    autocomplete="new-password" oninput="updateStrength(this.value)" required />
                  <button type="button" class="toggle-password" data-target="password" aria-label="Toggle password">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
                      stroke="currentColor" stroke-width="2">
                      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                      <circle cx="12" cy="12" r="3" />
                    </svg>
                  </button>
                </div>
                <div class="strength-meter">
                  <div class="strength-bar">
                    <div class="seg" id="seg1"></div>
                    <div class="seg" id="seg2"></div>
                    <div class="seg" id="seg3"></div>
                    <div class="seg" id="seg4"></div>
                  </div>
                  <span class="strength-label" id="strength-label">Enter a password</span>
                </div>
              </div>

              <div class="field-group">
                <label for="confirmPassword">Confirm password</label>
                <div class="input-wrap">
                  <svg class="input-icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                    fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="11" width="18" height="11" rx="2" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                  </svg>
                  <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Re-enter password"
                    autocomplete="new-password" required />
                  <button type="button" class="toggle-password" data-target="confirmPassword"
                    aria-label="Toggle confirm password">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
                      stroke="currentColor" stroke-width="2">
                      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                      <circle cx="12" cy="12" r="3" />
                    </svg>
                  </button>
                </div>
              </div>

              <label class="terms-row">
                <input type="checkbox" name="terms" id="terms" required />
                <span class="checkmark"></span>
                <span>I agree to the <a href="/terms" class="terms-link">Terms of Service</a> and <a href="/privacy"
                    class="terms-link">Privacy Policy</a></span>
              </label>

              <button type="submit" class="btn-submit">
                <span>Create Account</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2">
                  <line x1="5" y1="12" x2="19" y2="12" />
                  <polyline points="12 5 19 12 12 19" />
                </svg>
              </button>

            </form>

            <div class="divider"><span>or</span></div>

            <div class="login-prompt">
              Already have an account?
              <a href="/auth/login">Sign in</a>
            </div>

      </div>
    </div>

  </div>

  <script>
    // Password strength meter
    function updateStrength(val) {
      var score = 0;
      if (val.length >= 8) score++;
      if (/[A-Z]/.test(val)) score++;
      if (/[0-9]/.test(val)) score++;
      if (/[^A-Za-z0-9]/.test(val)) score++;

      var fills = [null, '#ef4444', '#f59e0b', '#22c55e', '#2563eb'];
      var labels = ['Enter a password', 'Weak', 'Fair', 'Strong', 'Very strong'];
      var colors = ['#e5e7eb', '#e5e7eb', '#e5e7eb', '#e5e7eb'];

      for (var i = 0; i < score; i++) colors[i] = fills[score];

      ['seg1', 'seg2', 'seg3', 'seg4'].forEach(function (id, i) {
        document.getElementById(id).style.background = colors[i];
      });

      var lbl = document.getElementById('strength-label');
      lbl.textContent = val.length === 0 ? 'Enter a password' : labels[score];
      lbl.style.color = val.length === 0 ? '' : fills[score];
    }

    // Toggle password visibility
    document.querySelectorAll('.toggle-password').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var target = document.getElementById(this.dataset.target);
        target.type = target.type === 'password' ? 'text' : 'password';
        this.classList.toggle('active');
      });
    });
  </script>

</body>

</html>