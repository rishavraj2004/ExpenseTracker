<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Expense Tracker Dashboard</title>

  <link rel="stylesheet" href="/css/dashboard.css">
</head>

<body>

  <div class="dashboard-container">

    <!-- Header -->

    <header class="dashboard-header">

      <div>
        <h1>Welcome, <%= user.firstName %> 👋</h1>
        <p>Manage your expenses efficiently</p>
      </div>

      <form action="/auth/logout" method="POST">
        <button class="logout-btn">
          Logout
        </button>
      </form>

    </header>

    <!-- Summary Card -->

    <section class="summary-card">

      <h3>Total Expenses</h3>

      <h2>
        ₹ <%= totalExpense %>
      </h2>

    </section>

    <!-- Add Expense Form -->

    <section class="form-card">

      <h2>Add New Expense</h2>

      <form action="/expenses/add" method="POST">

        <div class="form-group">

          <input type="number" name="amount" placeholder="Amount" required>

          <input type="text" name="spentOn" placeholder="Spent On" required>

        </div>

        <input type="text" name="note" placeholder="Note (Optional)">

        <button type="submit" class="add-btn">
          Add Expense
        </button>

      </form>

    </section>

    <!-- Expense List -->

    <section class="expense-section">

      <h2>Recent Expenses</h2>

      <% if(expenses.length===0){ %>

        <div class="empty-state">

          <p>No expenses found.</p>

        </div>

        <% } else { %>

          <table>

            <thead>

              <tr>
                <th>Amount</th>
                <th>Spent On</th>
                <th>Note</th>
                <th>Date</th>
                <th>Actions</th>
              </tr>

            </thead>

            <tbody>

              <% expenses.forEach(expense=> { %>

                <tr>

                  <td>
                    ₹<%= expense.amount %>
                  </td>

                  <td>
                    <%= expense.spentOn %>
                  </td>

                  <td>
                    <%= expense.note || '-' %>
                  </td>

                  <td>
                    <%= expense.createdAt.toLocaleDateString() %>
                  </td>

                  <td class="action-buttons">

                    <a href="/expenses/edit/<%= expense._id %>" class="edit-btn">
                      Edit
                    </a>

                    <form action="/expenses/delete/<%= expense._id %>" method="POST">

                      <button type="submit" class="delete-btn">
                        Delete
                      </button>

                    </form>

                  </td>

                </tr>

                <% }) %>

            </tbody>

          </table>

          <% } %>

    </section>

  </div>

</body>

</html>